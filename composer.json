{
    "name": "the-shit/finance",
    "description": "Personal finance tooling for Laravel — Plaid integration, privacy-first AI analysis, reusable provider contract.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nesbot/carbon": "^3.0",
        "saloonphp/saloon": "^3.0"
    },
    "suggest": {
        "prism-php/prism": "Optional cloud analysis via PrivacyTransformer"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "TheShit\\Finance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheShit\\Finance\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TheShit\\Finance\\FinanceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
